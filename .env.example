# NMI (Network Merchants Inc.) — Collect.js + Direct Post
#
# Public tokenization key — safe for the browser; used by Collect.js.
# When unset, checkout uses local card fields and tok_dev_* simulation.
NEXT_PUBLIC_NMI_TOKENIZATION_KEY=
# SERVER ONLY — private security key for transact.php (type=sale).
# (NMI_SECURITY_KEY is accepted as an alias.) When unset, charges are SIMULATED.
NMI_PRIVATE_SECURITY_KEY=
# Optional gateway endpoint override.
# NMI_API_URL=https://secure.networkmerchants.com/api/transact.php
# Card-statement descriptor shown on the customer's receipt.
NMI_DESCRIPTOR="ANGLER ASSISTANT"
# Webhook signing key — create the webhook in the NMI merchant portal
# (Settings -> Webhooks -> https://<your-domain>/api/webhooks/nmi).
NMI_WEBHOOK_SIGNING_KEY=
# Cloudinary (DL / ID uploads) — SERVER ONLY. Never expose the API secret to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
